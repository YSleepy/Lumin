        <file alias="DragController.qml">ThirdParty/QtFlexQml/qml/Dock/DragController.qml</file>
        <file alias="FlexWindow.qml">ThirdParty/QtFlexQml/qml/Dock/FlexWindow.qml</file>
        <file alias="FlexWindowFrame.qml">ThirdParty/QtFlexQml/qml/Dock/FlexWindowFrame.qml</file>
        <file alias="NodeView.qml">ThirdParty/QtFlexQml/qml/Dock/NodeView.qml</file>
        <file alias="SplitContainer.qml">ThirdParty/QtFlexQml/qml/Dock/SplitContainer.qml</file>
