project(@GAME_MODULE@)

find_package(Qt6 REQUIRED COMPONENTS Core Gui OpenGL)

set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${OUTPUT_DIR})

set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${OUTPUT_DIR})
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${OUTPUT_DIR})

add_library(@GAME_MODULE@ SHARED
    @GAME_MODULE@GameModule.cpp
    @GAME_MODULE@GameInstance.cpp
	@GAME_MODULE@GameActor.cpp
)

target_include_directories(@GAME_MODULE@
    PRIVATE
        ${CMAKE_CURRENT_SOURCE_DIR}
        @ENGINE_ROOT@/Src
        @ENGINE_ROOT@/Src/Engine
        @ENGINE_ROOT@/Src/Log
)

target_link_directories(@GAME_MODULE@
    PRIVATE
        @ENGINE_ROOT@
)

target_link_libraries(@GAME_MODULE@
    PRIVATE
        Lumin
        Qt6::Core
        Qt6::Gui
        Qt6::OpenGL
)

target_compile_definitions(@GAME_MODULE@
    PRIVATE
        @PROJECT_NAME_UPPER@_GAME_EXPORTS
)
